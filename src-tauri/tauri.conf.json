{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CentralByte",
  "version": "0.1.0",
  "identifier": "com.centralbyte.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "additionalWatchFolders": ["../crates"]
  },
  "app": {
    "windows": [
      {
        "title": "CentralByte",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Lucas Sabino",
    "copyright": "Copyright 2026 Lucas Sabino",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Desktop skin over real vendor CLIs",
    "longDescription": "CentralByte launches and displays real agent CLIs (Claude, Codex, Cursor) in a native desktop shell with PTY terminal, browser, and session tools.",
    "linux": {
      "deb": {
        "section": "devel"
      },
      "rpm": {
        "compression": {
          "type": "zstd",
          "level": 3
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
